{
  "name": "@ilya_coder/injektor",
  "module": "./dist/index.js",
  "type": "module",
  "private": false,
  "devDependencies": {
    "@types/bun": "latest",
    "mitata": "^1.0.34",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"


  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "node": "./dist/node.js",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "node": "./dist/index.cjs",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test:package": "sh scripts/test-package.sh",
    "prepare": "( (bun x -p typescript@5.7.3 tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --noEmit) || exit 1) && bun run build",
    "prepublishOnly": "( (bun x -p typescript@5.7.3 tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --noEmit) || exit 1) && bun run build"
  },

  "version": "1.1.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoTheCoderGo/Injektor.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
